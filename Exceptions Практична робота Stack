#include <iostream>
using namespace std;

class StackOverflowException : public exception
{
	int maxSize;
public:
	StackOverflowException(const char* message, int maxSize) : maxSize(maxSize),
		exception(message) {
	}
	void Message()
	{
		cout << what() << endl;
		cout << "Max stack size : " << maxSize << endl;
	}
};

class Stack
{
private:
	int* arr;
	int maxSize;
	int topIndex;

public:
	Stack(int maxSize = 10)
	{
		if (maxSize <= 0)
			throw invalid_argument("Max size is less than or equal to 0");

		if (maxSize > 1000000)
			throw exception("Cannot allocate memory for this size");

		this->maxSize = maxSize;
		topIndex = -1;
		arr = new int[maxSize] {};
	}

	~Stack()
	{
		delete[] arr;
	}

	bool IsEmpty() const
	{
		return topIndex == -1;
	}

	bool IsFull() const
	{
		return topIndex == maxSize - 1;
	}

	void Push(int value)
	{
		if (IsFull())
			throw StackOverflowException("Stack overflow", maxSize);

		arr[++topIndex] = value;
	}

	int Pop()
	{
		if (IsEmpty())
			throw out_of_range("Stack is empty");

		return arr[topIndex--];
	}

	int Peek() const
	{
		if (IsEmpty())
			throw out_of_range("Stack is empty");

		return arr[topIndex];
	}

	void Print() const
	{
		if (IsEmpty())
			throw logic_error("Stack is empty");

		for (int i = 0; i <= topIndex; i++)
		{
			cout << arr[i] << " ";
		}
		cout << endl;
	}
};

int main()
{
	try
	{
		Stack badStack(-5);
	}
	catch (invalid_argument ex)
	{
		cout << ex.what() << endl;
	}
	catch (exception ex)
	{
		cout << ex.what() << endl;
	}

	Stack st(3);

	try
	{
		st.Push(10);
		st.Push(20);
		st.Push(30);
		st.Print();

		st.Push(40);
	}
	catch (StackOverflowException ex)
	{
		ex.Message();
	}
	catch (exception ex)
	{
		cout << ex.what() << endl;
	}

	try
	{
		cout << st.Pop() << endl;
		cout << st.Pop() << endl;
		cout << st.Pop() << endl;

		cout << st.Pop() << endl;
	}
	catch (out_of_range ex)
	{
		cout << ex.what() << endl;
	}
	catch (logic_error ex)
	{
		cout << ex.what() << endl;
	}
	catch (...)
	{
		cout << "Unknown exception" << endl;
	}
}
