#include <iostream>
#include <list>
using namespace std;

template<typename T>
class List
{
	struct Node
	{
		T value;
		Node* next;
		Node() : value(T()), next(nullptr) {}
		Node(T value, Node* next) : value(value), next(next) {}
	};
	Node* head;
public:
	List()
	{
		head = nullptr;
	}
	void AddToHead(T value)
	{
		Node* newNode = new Node(value, head);
		head = newNode;
	}
	void Print()
	{
		Node* current = head;
		while (current != nullptr)
		{
			cout << current->value << " ";
			current = current->next;
		}
		cout << endl;
	}
	~List()
	{
		Node* current = nullptr;
		while (head != nullptr)
		{
			current = head;
			head = head->next;
			delete current;
		}
	}
	void AddToTail(T value)
	{
		Node* newNode = new Node(value, nullptr);
		if (head == nullptr)
		{
			head = newNode;
		}
		else
		{
			Node* current = head;
			while (current->next != nullptr)
			{
				current = current->next;
			}
			current->next = newNode;
		}
	}
	void DeleteFromHead()
	{
		if (head == nullptr) return;
		Node* current = head;
		head = head->next;
		delete current;
	}
	void DeleteFromTail()
	{
		if (head == nullptr) return;
		if (head->next == nullptr)
		{
			delete head;
			head = nullptr;
		}
		else
		{
			Node* current = head;
			while (current->next->next != nullptr)
			{
				current = current->next;
			}
			delete current->next;
			current->next = nullptr;
		}
	}
	bool IsEmpty()
	{
		return head == nullptr;
	}
};

class Point
{
	int x;
	int y;
public:
	Point() : x(0), y(0) {}
	Point(int x, int y) : x(x), y(y) {}

	friend ostream& operator<<(ostream& out, const Point& point)
	{
		out << "(" << point.x << ", " << point.y << ")";
		return out;
	}
};

class Vector
{
	//Point* points;
	List<Point> points;
	int size;
public:
	Vector() : size(0) {}
	Vector(Point p) : size(0)
	{
		AddPointToTail(p);
	}
	void AddPointToHead(Point p)
	{
		points.AddToHead(p);
		size++;
	}
	void AddPointToTail(Point p)
	{
		points.AddToTail(p);
		size++;
	}
	void DeletePointFromHead()
	{
		if (!points.IsEmpty())
		{
			points.DeleteFromHead();
			size--;
		}
	}
	void DeletePointFromTail()
	{
		if (!points.IsEmpty())
		{
			points.DeleteFromTail();
			size--;
		}
	}
	void Print()
	{
		cout << "Size: " << size << " | Points: ";
		points.Print();
	}
};

