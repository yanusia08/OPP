#include <iostream>
using namespace std;

class EmptyListException : public exception
{
public:
	EmptyListException(const char* message) : exception(message) {}
};

class InvalidPositionException : public exception
{
	int pos;
public:
	InvalidPositionException(const char* message, int pos) : pos(pos),
		exception(message) {
	}
	void Message()
	{
		cout << what() << endl;
		cout << "Entered position : " << pos << endl;
	}
};

class InvalidNumberFormatException : public exception
{
public:
	InvalidNumberFormatException(const char* message) : exception(message) {}
};

class IntRangeOverflowException : public exception
{
	const char* str;
public:
	IntRangeOverflowException(const char* message, const char* str) : str(str),
		exception(message) {
	}
	void Message()
	{
		cout << what() << endl;
		cout << "Input string : " << str << endl;
	}
};

struct Node
{
	int value;
	Node* prev;
	Node* next;
};

class List
{
private:
	Node* head;
	Node* tail;
	int size;

public:
	List()
	{
		head = nullptr;
		tail = nullptr;
		size = 0;
	}

	~List()
	{
		while (head != nullptr)
		{
			Node* temp = head;
			head = head->next;
			delete temp;
		}
	}

	void AddToHead(int value)
	{
		Node* newNode = new Node;
		newNode->value = value;
		newNode->prev = nullptr;
		newNode->next = head;

		if (size == 0)
		{
			head = tail = newNode;
		}
		else
		{
			head->prev = newNode;
			head = newNode;
		}
		size++;
	}

	void AddToTail(int value)
	{
		Node* newNode = new Node;
		newNode->value = value;
		newNode->next = nullptr;
		newNode->prev = tail;

		if (size == 0)
		{
			head = tail = newNode;
		}
		else
		{
			tail->next = newNode;
			tail = newNode;
		}
		size++;
	}

	void DeleteFromHead()
	{
		if (size == 0)
			throw EmptyListException("List is empty! Cannot delete from head.");

		if (size == 1)
		{
			delete head;
			head = tail = nullptr;
		}
		else
		{
			Node* temp = head;
			head = head->next;
			head->prev = nullptr;
			delete temp;
		}
		size--;
	}

	void DeleteFromTail()
	{
		if (size == 0)
			throw EmptyListException("List is empty! Cannot delete from tail.");

		if (size == 1)
		{
			delete tail;
			head = tail = nullptr;
		}
		else
		{
			Node* temp = tail;
			tail = tail->prev;
			tail->next = nullptr;
			delete temp;
		}
		size--;
	}

	void InsertByPos(int pos, int value)
	{
		if (pos < 0 || pos > size)
			throw InvalidPositionException("Invalid position for insert", pos);

		if (pos == 0)
		{
			AddToHead(value);
			return;
		}
		if (pos == size)
		{
			AddToTail(value);
			return;
		}

		Node* current = head;
		for (int i = 0; i < pos; i++)
		{
			current = current->next;
		}

		Node* newNode = new Node;
		newNode->value = value;
		newNode->prev = current->prev;
		newNode->next = current;

		current->prev->next = newNode;
		current->prev = newNode;
		size++;
	}

	void DeleteByPos(int pos)
	{
		if (size == 0)
			throw EmptyListException("List is empty! Cannot delete by position.");

		if (pos < 0 || pos >= size)
			throw InvalidPositionException("Invalid position for delete", pos);

		if (pos == 0)
		{
			DeleteFromHead();
			return;
		}
		if (pos == size - 1)
		{
			DeleteFromTail();
			return;
		}

		Node* current = head;
		for (int i = 0; i < pos; i++)
		{
			current = current->next;
		}

		current->prev->next = current->next;
		current->next->prev = current->prev;
		delete current;
		size--;
	}

	int GetElementByPos(int pos) const
	{
		if (size == 0)
			throw EmptyListException("List is empty! No elements.");

		if (pos < 0 || pos >= size)
			throw out_of_range("Index is less than 0 or more than size");

		Node* current = head;
		for (int i = 0; i < pos; i++)
		{
			current = current->next;
		}
		return current->value;
	}

	void Print() const
	{
		if (size == 0)
			throw logic_error("List is empty! Nothing to print.");

		Node* current = head;
		while (current != nullptr)
		{
			cout << current->value << " ";
			current = current->next;
		}
		cout << endl;
	}
};

int StringToInt(const char* str)
{
	if (str == nullptr || strlen(str) == 0)
		throw invalid_argument("String is empty");

	int i = 0;
	int sign = 1;

	if (str[0] == '-')
	{
		sign = -1;
		i = 1;
	}
	else if (str[0] == '+')
	{
		i = 1;
	}

	if (str[i] == '\0')
		throw InvalidNumberFormatException("String contains only sign, no digits");

	long long result = 0;

	for (; str[i] != '\0'; i++)
	{
		if (!isdigit(str[i]))
			throw InvalidNumberFormatException("String does not represent a decimal number");

		int digit = str[i] - '0';
		result = result * 10 + digit;

		if (sign == 1 and result > 2147483647)
			throw IntRangeOverflowException("Number exceeds maximum int value", str);

		if (sign == -1 and result > 2147483648LL)
			throw IntRangeOverflowException("Number is less than minimum int value", str);
	}

	return (int)(result * sign);
}

int main()
{
	List list;

	try
	{
		list.DeleteFromHead();
	}
	catch (EmptyListException ex)
	{
		cout << ex.what() << endl;
	}

	char input[100];

	for (int i = 0; i < 4; i++)
	{
		cout << "Enter number string to add to list : ";
		cin >> input;

		try
		{
			int number = StringToInt(input);
			list.AddToTail(number);
			cout << "Added : " << number << endl;
		}
		catch (InvalidNumberFormatException ex)
		{
			cout << "Format error : " << ex.what() << endl;
		}
		catch (IntRangeOverflowException ex)
		{
			ex.Message();
		}
		catch (invalid_argument ex)
		{
			cout << ex.what() << endl;
		}
		catch (exception ex)
		{
			cout << "General error : " << ex.what() << endl;
		}
		catch (...)
		{
			cout << "Unknown exception" << endl;
		}
	}

	try
	{
		list.Print();
		list.InsertByPos(10, 99);
	}
	catch (InvalidPositionException ex)
	{
		ex.Message();
	}
	catch (logic_error ex)
	{
		cout << ex.what() << endl;
	}

	try
	{
		cout << list.GetElementByPos(-2) << endl;
	}
	catch (EmptyListException ex)
	{
		cout << ex.what() << endl;
	}
	catch (out_of_range ex)
	{
		cout << ex.what() << endl;
	}
	catch (exception ex)
	{
		cout << ex.what() << endl;
	}
	catch (...)
	{
		cout << "Unknown exception" << endl;
	}
}
